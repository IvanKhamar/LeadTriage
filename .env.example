# Copy to .env (git-ignored) and replace every change-me value. Never commit .env.
# For the mock demo the values below work as they are; change them before anything leaves your machine.

# --- FastAPI app ---
# Token n8n must send in X-Webhook-Token; the app adds it when it forwards a lead.
WEBHOOK_TOKEN=change-me-webhook-token
# Token n8n sends to /api/enrich and /api/validate.
ENRICH_TOKEN=change-me-enrich-token
# One token per server-to-server source (header X-Source-Token). Verde Kitchen keeps the same value on its side.
SOURCE_TOKEN_VERDE_KITCHEN=change-me-verde-kitchen-token
# Where the app forwards leads (n8n service name inside the compose network).
N8N_WEBHOOK_URL=http://n8n:5678/webhook/leads
# Demo form rate limit per IP.
RATE_LIMIT_PER_MINUTE=5

# --- n8n ---
# Encrypts n8n's credential store. Generate a long random value once and keep it; losing it loses the credentials.
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# mock = fixed classification, no API call; mock-fail = simulated LLM failure;
# claude = Claude (needs ANTHROPIC_API_KEY); gemini = Gemini (needs GEMINI_API_KEY; free tier: invented data only).
LLM_MODE=mock
# off = skip Airtable (demo without an account); on = write to Airtable.
AIRTABLE_MODE=off

# --- Claude (only for LLM_MODE=claude) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=2000
# USD per million tokens (claude-haiku-5-5, prompts up to 100K tokens; checked 2026-11-21). Update when the model changes.
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50

# --- Gemini (only for LLM_MODE=gemini) ---
# Free tier: Google may use the content to improve its products, so only invented leads go through it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# USD per million tokens; 0 on the free tier.
GEMINI_PRICE_INPUT_PER_MTOK=0
GEMINI_PRICE_OUTPUT_PER_MTOK=0

# --- Airtable (only for AIRTABLE_MODE=on) ---
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# --- Notifications (optional) ---
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
