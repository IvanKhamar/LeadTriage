    },
    {
      "id": "6d0a1c1e-3b7a-4c4f-9a51-0c8f6b6c1a11",
      "name": "Prepare record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -100
      ],
      "parameters": {
        "jsCode": "// Airtable fields named exactly like the columns: the Create/Update nodes \"auto-map\" them as they are.\n// $json is the record \"Find by email\" found (same e-mail, last 30 days), or an empty item when there is none.\nconst r = $('Build result').first().json.record;\nconst found = $json.id ? $json : null;\nconst present = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== null && v !== undefined));\n\nconst fields = present({\n  Name: r.name,\n  Email: r.email,\n  Phone: r.phone,\n  Source: r.source,\n  ExternalId: r.externalId,\n  Message: r.message,\n  Category: r.category,\n  Priority: r.priority,\n  Language: r.language,\n  Summary: r.summary,\n  ReplyDraft: r.replyDraft,\n  Confidence: r.confidence,\n  NeedsReview: r.needsReview,\n  Issues: (r.issues || []).join('\\n'),\n  RawText: r.rawText ?? '',\n  EmailDomain: r.emailDomain,\n  FreeMail: r.freeMail,\n  Disposable: r.disposable,\n  PhoneCountry: r.phoneCountry,\n  Model: r.model,\n  InputTokens: r.inputTokens,\n  OutputTokens: r.outputTokens,\n  CostUsd: r.costUsd,\n  LatencyMs: r.latencyMs,\n  ReceivedAt: r.receivedAt,\n});\n\nif (found) {\n  // Same person again: the record shows the newest message, the earlier one moves to History (newest first).\n  const old = found.fields ?? found;\n  const when = old.ReceivedAt ? DateTime.fromISO(old.ReceivedAt).setZone('Europe/Kyiv').toFormat('yyyy-LL-dd HH:mm') : '?';\n  const earlier = `[${when}] ${old.Message ?? ''}`;\n  fields.History = [earlier, old.History].filter(Boolean).join('\\n\\n').slice(0, 95000);\n  return [{ json: { id: found.id, ...fields } }];\n}\nreturn [{ json: { ...fields, LeadId: r.leadId, Status: 'new' } }];\n"
      }
    },
