    {
      "id": "6d0a1c1e-3b7a-4c4f-9a51-0c8f6b6c1a07",
      "name": "Build result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// One record with everything known about the lead: the input for Airtable and the webhook answer.\nconst lead = $('Normalise').first().json;\nconst enrich = $('Enrich').first().json;\nconst llm = $('LLM result').first().json;\nconst checked = $json;\nconst c = checked.classification;\nconst needsReview = checked.needsReview || Boolean(llm.llmError);\nconst issues = llm.llmError ? [llm.llmError, ...checked.issues] : checked.issues;\n\nconst record = {\n  ...lead,\n  category: c.category,\n  priority: c.priority,\n  language: c.language,\n  summary: c.summary,\n  replyDraft: c.replyDraft,\n  confidence: c.confidence,\n  needsReview,\n  issues,\n  rawText: checked.rawText,\n  emailDomain: enrich.emailDomain,\n  freeMail: enrich.freeMail,\n  disposable: enrich.disposable,\n  phoneCountry: enrich.phoneCountry,\n  model: llm.model,\n  inputTokens: llm.inputTokens,\n  outputTokens: llm.outputTokens,\n  costUsd: checked.costUsd,\n  latencyMs: llm.latencyMs,\n};\n\nreturn [{\n  json: {\n    leadId: lead.leadId,\n    record,\n    // What the demo form shows. No personal data beyond what the visitor just typed.\n    triage: { classification: c, needsReview, issues, model: llm.model, costUsd: checked.costUsd, enrich },\n  },\n}];\n"
      }
    },
    {
