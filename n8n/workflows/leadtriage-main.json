          "mode": "id",
          "value": "={{ $env.AIRTABLE_BASE_ID }}"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "Leads"
        },
        "filterByFormula": "=AND({Email} = {{ JSON.stringify($('Build result').first().json.record.email) }}, IS_AFTER({ReceivedAt}, DATEADD(NOW(), -30, 'days')))",
        "returnAll": false,
        "limit": 1,
        "options": {},
        "sort": {
          "property": [
            {
              "field": "ReceivedAt",
              "direction": "desc"
            }
          ]
        }
