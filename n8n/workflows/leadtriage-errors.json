      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// What a person needs to find the failure in n8n's Executions list. No payload and no secrets: only names,\n// the error message (e-mail addresses masked, cut to 500 characters), the execution id and the time.\nconst e = $json;\nconst message = String(e.execution?.error?.message ?? 'unknown error')\n  .replace(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g, '[e-mail]')\n  .slice(0, 500);\n\nreturn [{\n  json: {\n    Workflow: e.workflow?.name ?? 'unknown',\n    Node: e.execution?.lastNodeExecuted ?? e.execution?.error?.node?.name ?? '',\n    Message: message,\n    ExecutionId: String(e.execution?.id ?? ''),\n    OccurredAt: new Date().toISOString(),\n  },\n}];\n"
      }
    },
    {
      "id": "7e1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c03",
